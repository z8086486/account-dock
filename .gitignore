# Deny by default. Explicitly allow reviewed public project files below.
/*
!/.gitignore
!/README.md
!/Package.swift
!/Sources/
!/scripts/
!/tests/

/Sources/*
!/Sources/AccountDock/
/Sources/AccountDock/*
!/Sources/AccountDock/AccountDockApp.swift
!/Sources/AccountDock/AccountStore.swift

/scripts/*
!/scripts/doctor.py
/tests/*
!/tests/test_doctor.py

# Private work records and local tooling (never publish).
/docs/
/.local/
/.codex/
/.claude/
/.vscode/
/.idea/
AGENTS.md
CLAUDE.md
SKILL.md
/tmp

# Credentials, diagnostics, and generated artifacts.
.env
.env.*
auth.json
credentials.json
*.pem
*.key
*.p12
*.log
.DS_Store
.build/
.swiftpm/
dist/
__pycache__/
*.pyc

# Reviewed Swift tests.
!/tests/AccountDockTests/
/tests/AccountDockTests/*
!/tests/AccountDockTests/PresetTests.swift

# Reviewed design, versioning, and packaging files.
!/Package.resolved
!/RELEASING.md
!/Sources/AccountDock/Theme.swift
!/Sources/AccountDock/Updates.swift
!/Sources/AccountDock/Resources/
/Sources/AccountDock/Resources/*
!/Sources/AccountDock/Resources/release.json
!/scripts/versions.py
!/scripts/package_app.py
!/tests/test_versions.py
!/tests/AccountDockTests/VersionTests.swift
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/preview.yml

# Reviewed account onboarding, usage, and original app icon.
!/Sources/AccountDock/Setup.swift
!/Sources/AccountDock/Usage.swift
!/Sources/AccountDock/Resources/AppIcon.icns
!/Sources/AccountDock/Resources/AccountDock.png
!/scripts/usage.py
!/scripts/generate_icon.swift
!/tests/test_usage.py

# Reviewed app-specific source lookup and release checklist.
!/Sources/AccountDock/AppAccounts.swift
!/scripts/app_accounts.py
!/tests/test_app_accounts.py
!/RELEASE_CHECKLIST.md

# Reviewed native runtime, switch protection, and local installation tooling.
!/Sources/AccountDock/CodexService.swift
!/Sources/AccountDock/SwitchSafety.swift
!/Sources/AccountDock/VersionService.swift
!/scripts/install_local.py
!/scripts/release_preflight.py
!/tests/AccountDockTests/NativeTests.swift
!/tests/test_install_local.py
